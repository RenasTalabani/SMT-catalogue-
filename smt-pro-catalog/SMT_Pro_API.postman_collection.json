  },
  "variable": [
    { "key": "base_url",         "value": "http://localhost:3000", "type": "string" },
    { "key": "token",            "value": "",                      "type": "string" },
    { "key": "product_id",       "value": "1",                     "type": "string" },
    { "key": "category_id",      "value": "1",                     "type": "string" },
    { "key": "order_id",         "value": "1",                     "type": "string" },
    { "key": "supplier_id",      "value": "1",                     "type": "string" },
    { "key": "expense_id",       "value": "1",                     "type": "string" },
    { "key": "income_id",        "value": "1",                     "type": "string" },
    { "key": "notification_id",  "value": "1",                     "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [

    {
      "name": "🟢 Health",
