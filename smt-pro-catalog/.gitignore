# ─── Backend ──────────────────────────────────────────────────────────────────
backend/node_modules/
backend/dist/
backend/.env
backend/logs/
backend/npm-debug.log*
backend/yarn-debug.log*
backend/yarn-error.log*

# SQLite dev databases (never commit these)
backend/prisma/*.db
backend/prisma/**/*.db

# Uploaded files (stored in Supabase, not git)
backend/public/uploads/products/*
!backend/public/uploads/products/.gitkeep

# ─── Web ──────────────────────────────────────────────────────────────────────
web/node_modules/
web/.next/
web/.env
web/.env.local

# ─── Flutter ──────────────────────────────────────────────────────────────────
flutter_app/.dart_tool/
flutter_app/.packages
flutter_app/build/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/.metadata
flutter_app/pubspec.lock

# ─── General ──────────────────────────────────────────────────────────────────
*.log
.vscode/
.idea/
.DS_Store
Thumbs.db
