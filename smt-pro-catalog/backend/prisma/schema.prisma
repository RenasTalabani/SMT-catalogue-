generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth / Users ─────────────────────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  role         String   @default("employee")
  fcmToken     String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders            Order[]
  invoices          Invoice[]        @relation("InvoiceCreator")
  expenses          Expense[]        @relation("ExpenseCreator")
  incomes           Income[]         @relation("IncomeCreator")
  stockMovements    StockMovement[]  @relation("StockEmployee")
  auditLogs         AuditLog[]
  notifications     Notification[]
  purchaseOrders    PurchaseOrder[]  @relation("POCreator")
  returnRequests    ReturnRequest[]  @relation("ReturnRequester")
  returnReviews     ReturnRequest[]  @relation("ReturnReviewer")
  couponUsages      CouponUsage[]    @relation("CouponUser")
  stocktakesCreated  Stocktake[]        @relation("StocktakeCreator")
  stocktakesReviewed Stocktake[]       @relation("StocktakeReviewer")
  shifts             Shift[]           @relation("ShiftEmployee")
  stockTransfers     StockTransfer[]   @relation("TransferCreator")
  backorderRequests  BackorderRequest[] @relation("BackorderRequester")
  customerNotes      CustomerNote[]     @relation("NoteAuthor")

  @@index([email])
  @@index([role])
  @@index([isActive])
}

// ─── Catalogue ────────────────────────────────────────────────────────────────

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  nameAr      String?
  nameKu      String?
  slug        String    @unique
  description String?   @db.Text
  imageUrl    String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  parentId    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent           Category?             @relation("CategoryTree", fields: [parentId], references: [id])
  children         Category[]            @relation("CategoryTree")
  products         Product[]
  attributeDefs    AttributeDefinition[]

  @@index([parentId])
  @@index([slug])
  @@index([isActive])
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?  @db.Text
  price         Float
  costPrice     Float    @default(0)
  quantity      Int      @default(0)
  lowStockAlert Int      @default(5)
  imageUrl      String?
  imagePublicId String?
  categoryId    Int?
  category      String
  sku           String?  @unique
  barcode       String?  @unique
  unit          String    @default("piece")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  categoryRef        Category?          @relation(fields: [categoryId], references: [id])
  orderItems         OrderItem[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  returnItems        ReturnItem[]
  stocktakeItems     StocktakeItem[]
  priceListItems     PriceListItem[]
  bundleItems        BundleItem[]
  tags               ProductTag[]
  supplierProducts   SupplierProduct[]
  backorders         BackorderRequest[]
  attributes         ProductAttribute[]
  variants           ProductVariant[]
  locationStocks     LocationStock[]
  transferItems      StockTransferItem[]

  @@index([categoryId])
  @@index([category])
  @@index([quantity])
  @@index([isActive])
  @@index([createdAt])
  @@index([barcode])
  @@index([deletedAt])
}

// ─── Orders / POS ─────────────────────────────────────────────────────────────

model Order {
  id            Int      @id @default(autoincrement())
  userId        Int
  customerId    Int?
  totalAmount   Float
  discount      Float    @default(0)
  tax           Float    @default(0)
  finalAmount   Float    @default(0)
  status        String   @default("PENDING")
  paymentMethod String   @default("CASH")
  notes         String?  @db.Text
  receiptUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  customer       Customer?       @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  invoice        Invoice?
  returnRequests    ReturnRequest[]
  couponUsage       CouponUsage?
  shiftOrders       ShiftOrder[]
  variantOrderItems VariantOrderItem[]
  paymentPlan       PaymentPlan?

  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@index([customerId])
  @@index([paymentMethod])
}

model OrderItem {
  id        Int   @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Float
  discount  Float @default(0)

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id])
  returnItems ReturnItem[]

  @@index([productId])
  @@index([orderId])
}

// ─── Returns & Refunds ────────────────────────────────────────────────────────

model ReturnRequest {
  id          Int      @id @default(autoincrement())
  orderId     Int
  requestedBy Int
  reviewedBy  Int?
  status      String   @default("PENDING")   // PENDING, APPROVED, REJECTED, PROCESSED
  reason      String
  notes       String?  @db.Text
  refundAmount Float   @default(0)
  refundMethod String  @default("ORIGINAL")  // ORIGINAL, STORE_CREDIT, CASH
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order     Order              @relation(fields: [orderId], references: [id])
  requester User               @relation("ReturnRequester", fields: [requestedBy], references: [id])
  reviewer  User?              @relation("ReturnReviewer",  fields: [reviewedBy],  references: [id])
  items     ReturnItem[]

  @@index([orderId])
  @@index([requestedBy])
  @@index([status])
  @@index([createdAt])
}

model ReturnItem {
  id              Int   @id @default(autoincrement())
  returnRequestId Int
  productId       Int
  orderItemId     Int
  quantity        Int
  unitPrice       Float
  condition       String @default("GOOD")   // GOOD, DAMAGED, DEFECTIVE

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])

  @@index([returnRequestId])
  @@index([productId])
}

// ─── Coupons / Discounts ──────────────────────────────────────────────────────

model Coupon {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  description  String?
  type         String   @default("PERCENTAGE")  // PERCENTAGE, FIXED
  value        Float
  minOrderAmount Float  @default(0)
  maxUses      Int?
  usedCount    Int      @default(0)
  isActive     Boolean  @default(true)
  validFrom    DateTime @default(now())
  validUntil   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  usages CouponUsage[]

  @@index([code])
  @@index([isActive])
  @@index([validFrom])
  @@index([validUntil])
}

model CouponUsage {
  id        Int      @id @default(autoincrement())
  couponId  Int
  orderId   Int      @unique
  userId    Int
  discount  Float
  usedAt    DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  order  Order  @relation(fields: [orderId],  references: [id])
  user   User   @relation("CouponUser", fields: [userId], references: [id])

  @@index([couponId])
  @@index([userId])
  @@index([usedAt])
}

// ─── Finance ──────────────────────────────────────────────────────────────────

model Expense {
  id        Int      @id @default(autoincrement())
  amount    Float
  category  String
  notes     String?  @db.Text
  createdBy Int
  createdAt DateTime @default(now())

  creator User @relation("ExpenseCreator", fields: [createdBy], references: [id])

  @@index([createdAt])
  @@index([createdBy])
  @@index([category])
}

model Income {
  id        Int      @id @default(autoincrement())
  amount    Float
  source    String
  notes     String?  @db.Text
  createdBy Int
  createdAt DateTime @default(now())

  creator User @relation("IncomeCreator", fields: [createdBy], references: [id])

  @@index([createdAt])
  @@index([createdBy])
  @@index([source])
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model Supplier {
  id             Int             @id @default(autoincrement())
  name           String
  phone          String?
  email          String?         @unique
  address        String?         @db.Text
  notes          String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt         DateTime?
  stockMovements    StockMovement[]
  purchaseOrders    PurchaseOrder[]
  supplierProducts  SupplierProduct[]

  @@index([name])
  @@index([deletedAt])
}

model StockMovement {
  id          Int      @id @default(autoincrement())
  productId   Int
  type        String
  quantity    Int
  previousQty Int
  newQty      Int
  notes       String?  @db.Text
  employeeId  Int
  supplierId  Int?
  reference   String?
  createdAt   DateTime @default(now())

  product  Product   @relation(fields: [productId], references: [id])
  employee User      @relation("StockEmployee", fields: [employeeId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([productId])
  @@index([employeeId])
  @@index([createdAt])
  @@index([type])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  body      String   @db.Text
  type      String   @default("info")
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
}

// ─── Audit ────────────────────────────────────────────────────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  entity    String
  entityId  Int?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
}

// ─── Invoices ─────────────────────────────────────────────────────────────────

model Invoice {
  id              Int       @id @default(autoincrement())
  invoiceNumber   String    @unique
  orderId         Int       @unique
  createdById     Int

  status          String    @default("ISSUED")  // DRAFT, ISSUED, PAID, CANCELLED

  // Customer snapshot at invoice time
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  customerAddress String?

  // Financials
  subtotal        Float
  discountType    String    @default("FIXED")   // FIXED, PERCENTAGE
  discountValue   Float     @default(0)
  discountAmount  Float     @default(0)
  taxRate         Float     @default(0)
  taxAmount       Float     @default(0)
  total           Float

  paymentMethod   String    @default("CASH")
  notes           String?   @db.Text

  // PDF storage in Supabase
  pdfUrl          String?
  pdfPublicId     String?

  // QR code data
  qrData          String?

  issuedAt        DateTime  @default(now())
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  order     Order         @relation(fields: [orderId], references: [id])
  createdBy User          @relation("InvoiceCreator", fields: [createdById], references: [id])
  items     InvoiceItem[]

  @@index([invoiceNumber])
  @@index([orderId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  productName String
  productSku  String?
  quantity    Int
  unitPrice   Float
  discount    Float   @default(0)
  total       Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ─── Purchase Orders ──────────────────────────────────────────────────────────

model PurchaseOrder {
  id           Int      @id @default(autoincrement())
  poNumber     String   @unique
  supplierId   Int
  createdById  Int
  status       String   @default("DRAFT")   // DRAFT, SENT, PARTIAL, RECEIVED, CANCELLED
  notes        String?  @db.Text
  expectedDate DateTime?
  receivedAt   DateTime?
  subtotal     Float    @default(0)
  total        Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplier  Supplier           @relation(fields: [supplierId], references: [id])
  createdBy User               @relation("POCreator", fields: [createdById], references: [id])
  items     PurchaseOrderItem[]

  @@index([supplierId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@index([poNumber])
}

model PurchaseOrderItem {
  id               Int    @id @default(autoincrement())
  purchaseOrderId  Int
  productId        Int
  orderedQty       Int
  receivedQty      Int    @default(0)
  unitCost         Float
  total            Float

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

// ─── Customers ────────────────────────────────────────────────────────────────

model Customer {
  id          Int       @id @default(autoincrement())
  name        String
  phone       String?
  email       String?   @unique
  address     String?   @db.Text
  notes       String?   @db.Text
  priceListId Int?
  taxExempt   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  orders         Order[]
  loyaltyAccount LoyaltyAccount?
  priceList      PriceList?       @relation("CustomerPriceList", fields: [priceListId], references: [id])
  backorders     BackorderRequest[]
  crmNotes       CustomerNote[]     @relation("CustomerCRMNotes")

  @@index([name])
  @@index([phone])
  @@index([email])
  @@index([createdAt])
  @@index([deletedAt])
}

// ─── Customer Loyalty ─────────────────────────────────────────────────────────

model LoyaltyAccount {
  id             Int      @id @default(autoincrement())
  customerId     Int      @unique
  points         Int      @default(0)
  lifetimePoints Int      @default(0)
  tier           String   @default("BRONZE")   // BRONZE, SILVER, GOLD, PLATINUM
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer     Customer             @relation(fields: [customerId], references: [id])
  transactions LoyaltyTransaction[]

  @@index([customerId])
  @@index([tier])
  @@index([points])
}

model LoyaltyTransaction {
  id          Int      @id @default(autoincrement())
  accountId   Int
  type        String                // EARN, REDEEM, ADJUST, EXPIRE
  points      Int
  balance     Int
  orderId     Int?
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([type])
  @@index([createdAt])
  @@index([orderId])
}

// ─── Stocktake / Cycle Count ──────────────────────────────────────────────────

model Stocktake {
  id          Int      @id @default(autoincrement())
  reference   String   @unique
  status      String   @default("DRAFT")   // DRAFT, IN_PROGRESS, COMPLETED, CANCELLED
  notes       String?  @db.Text
  createdById Int
  reviewedById Int?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy  User            @relation("StocktakeCreator",  fields: [createdById],  references: [id])
  reviewedBy User?           @relation("StocktakeReviewer", fields: [reviewedById], references: [id])
  items      StocktakeItem[]

  @@index([status])
  @@index([createdById])
  @@index([createdAt])
}

model StocktakeItem {
  id           Int     @id @default(autoincrement())
  stocktakeId  Int
  productId    Int
  expectedQty  Int
  countedQty   Int?
  variance     Int?
  notes        String?

  stocktake Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([stocktakeId, productId])
  @@index([stocktakeId])
  @@index([productId])
}

// ─── Price Lists ──────────────────────────────────────────────────────────────

model PriceList {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  type        String   @default("CUSTOM")   // RETAIL, WHOLESALE, VIP, CUSTOM
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items     PriceListItem[]
  customers Customer[]      @relation("CustomerPriceList")

  @@index([type])
  @@index([isDefault])
  @@index([isActive])
}

model PriceListItem {
  id          Int   @id @default(autoincrement())
  priceListId Int
  productId   Int
  price       Float
  discount    Float @default(0)   // percentage off the listed price

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId],   references: [id])

  @@unique([priceListId, productId])
  @@index([priceListId])
  @@index([productId])
}

// ─── Product Bundles / Kits ───────────────────────────────────────────────────

model Bundle {
  id               Int      @id @default(autoincrement())
  name             String
  description      String?  @db.Text
  imageUrl         String?
  price            Float
  compareAtPrice   Float?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items BundleItem[]

  @@index([isActive])
  @@index([createdAt])
}

model BundleItem {
  id        Int   @id @default(autoincrement())
  bundleId  Int
  productId Int
  quantity  Int   @default(1)

  bundle  Bundle  @relation(fields: [bundleId],  references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([bundleId, productId])
  @@index([bundleId])
  @@index([productId])
}

// ─── Product Tags & Labels ────────────────────────────────────────────────────

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  color     String   @default("#6366f1")   // hex color for UI badges
  createdAt DateTime @default(now())

  products ProductTag[]

  @@index([slug])
}

model ProductTag {
  productId Int
  tagId     Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId],     references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([productId])
  @@index([tagId])
}

// ─── Cash Register / Shift Management ────────────────────────────────────────

model Register {
  id        Int      @id @default(autoincrement())
  name      String
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  shifts Shift[]

  @@index([isActive])
}

model Shift {
  id             Int       @id @default(autoincrement())
  registerId     Int
  employeeId     Int
  status         String    @default("OPEN")   // OPEN, CLOSED
  openingFloat   Float     @default(0)
  closingFloat   Float?
  expectedCash   Float?
  cashVariance   Float?
  totalSales     Float     @default(0)
  totalOrders    Int       @default(0)
  notes          String?   @db.Text
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  register Register @relation(fields: [registerId], references: [id])
  employee User     @relation("ShiftEmployee", fields: [employeeId], references: [id])
  orders   ShiftOrder[]

  @@index([registerId])
  @@index([employeeId])
  @@index([status])
  @@index([openedAt])
}

model ShiftOrder {
  shiftId Int
  orderId Int

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id])

  @@id([shiftId, orderId])
  @@index([shiftId])
  @@index([orderId])
}

// ─── Supplier Product Catalog ─────────────────────────────────────────────────

model SupplierProduct {
  id            Int      @id @default(autoincrement())
  supplierId    Int
  productId     Int
  supplierSku   String?
  unitCost      Float
  leadTimeDays  Int      @default(0)
  minOrderQty   Int      @default(1)
  packSize      Int      @default(1)   // units per pack/reel
  isPreferred   Boolean  @default(false)
  notes         String?
  lastUpdated   DateTime @default(now())
  createdAt     DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId],  references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([supplierId])
  @@index([productId])
  @@index([isPreferred])
  @@index([unitCost])
}

// ─── Backorders / Waitlist ────────────────────────────────────────────────────

model BackorderRequest {
  id          Int      @id @default(autoincrement())
  productId   Int
  customerId  Int?
  requestedBy Int
  quantity    Int
  status      String   @default("PENDING")   // PENDING, PARTIALLY_FULFILLED, FULFILLED, CANCELLED
  notes       String?
  notifiedAt  DateTime?
  fulfilledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product    Product   @relation(fields: [productId],   references: [id])
  customer   Customer? @relation(fields: [customerId],  references: [id])
  requester  User      @relation("BackorderRequester", fields: [requestedBy], references: [id])

  @@index([productId])
  @@index([customerId])
  @@index([requestedBy])
  @@index([status])
  @@index([createdAt])
}

// ─── Webhooks ─────────────────────────────────────────────────────────────────

model Webhook {
  id          Int      @id @default(autoincrement())
  name        String
  url         String
  secret      String
  events      String   @db.Text   // comma-separated: order.created,stock.low,...
  isActive    Boolean  @default(true)
  headers     Json?               // extra headers to send
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([isActive])
}

model WebhookDelivery {
  id           Int      @id @default(autoincrement())
  webhookId    Int
  event        String
  payload      Json
  status       String   @default("PENDING")   // PENDING, SUCCESS, FAILED
  responseCode Int?
  responseBody String?  @db.Text
  durationMs   Int?
  attempt      Int      @default(1)
  createdAt    DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([event])
  @@index([status])
  @@index([createdAt])
}

// ─── CRM Customer Notes ───────────────────────────────────────────────────────

model CustomerNote {
  id          Int      @id @default(autoincrement())
  customerId  Int
  createdBy   Int
  type        String   @default("NOTE")   // NOTE, CALL, EMAIL, MEETING, FOLLOW_UP
  content     String   @db.Text
  followUpAt  DateTime?
  isResolved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, name: "CustomerCRMNotes")
  author    User     @relation("NoteAuthor", fields: [createdBy], references: [id])

  @@index([customerId])
  @@index([createdBy])
  @@index([type])
  @@index([followUpAt])
  @@index([isResolved])
  @@index([createdAt])
}

// ─── Product Attributes / Specifications ──────────────────────────────────────

model AttributeDefinition {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  unit         String?
  type         String   @default("TEXT")   // TEXT, NUMBER, BOOLEAN
  isFilterable Boolean  @default(true)
  categoryId   Int?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  category   Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  attributes ProductAttribute[]

  @@index([categoryId])
  @@index([isFilterable])
}

model ProductAttribute {
  id            Int     @id @default(autoincrement())
  productId     Int
  attributeId   Int
  value         String
  numericValue  Float?

  product   Product             @relation(fields: [productId],   references: [id], onDelete: Cascade)
  attribute AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([productId])
  @@index([attributeId])
  @@index([numericValue])
}

// ─── Tax Rate Configuration ───────────────────────────────────────────────────

model TaxRate {
  id          Int      @id @default(autoincrement())
  name        String
  rate        Float
  type        String   @default("VAT")    // VAT, GST, SALES, CUSTOM
  countryCode String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isDefault])
  @@index([isActive])
  @@index([type])
}

// ─── Expense Budgets ──────────────────────────────────────────────────────────

model Budget {
  id        Int      @id @default(autoincrement())
  category  String
  amount    Float
  period    String   @default("MONTHLY")   // MONTHLY, QUARTERLY, ANNUAL
  year      Int
  month     Int?     // 1-12 (MONTHLY only)
  quarter   Int?     // 1-4  (QUARTERLY only)
  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, period, year, month, quarter])
  @@index([category])
  @@index([period])
  @@index([year])
  @@index([isActive])
}

// ─── Product Variants ─────────────────────────────────────────────────────────

model ProductVariant {
  id          Int      @id @default(autoincrement())
  parentId    Int
  name        String
  sku         String?  @unique
  barcode     String?  @unique
  price       Float
  costPrice   Float    @default(0)
  quantity    Int      @default(0)
  attributes  Json?
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent     Product             @relation(fields: [parentId], references: [id], onDelete: Cascade)
  orderItems VariantOrderItem[]

  @@index([parentId])
  @@index([sku])
  @@index([isActive])
}

model VariantOrderItem {
  id        Int   @id @default(autoincrement())
  orderId   Int
  variantId Int
  quantity  Int
  price     Float
  discount  Float @default(0)

  order   Order          @relation(fields: [orderId],   references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

// ─── Scheduled Report Emails ──────────────────────────────────────────────────

model ReportSchedule {
  id         Int       @id @default(autoincrement())
  type       String                         // DAILY_SALES, WEEKLY_INVENTORY, MONTHLY_PROFIT, LOW_STOCK
  frequency  String    @default("DAILY")    // DAILY, WEEKLY, MONTHLY
  recipients Json                           // string[]
  isActive   Boolean   @default(true)
  lastSentAt DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([type])
  @@index([isActive])
  @@index([nextRunAt])
}

// ─── Multi-Warehouse / Locations ──────────────────────────────────────────────

model Location {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  address   String?  @db.Text
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks    LocationStock[]
  fromTransfers StockTransfer[] @relation("TransferFrom")
  toTransfers   StockTransfer[] @relation("TransferTo")

  @@index([code])
  @@index([isDefault])
  @@index([isActive])
}

model LocationStock {
  id         Int @id @default(autoincrement())
  locationId Int
  productId  Int
  quantity   Int @default(0)

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId],  references: [id], onDelete: Cascade)

  @@unique([locationId, productId])
  @@index([locationId])
  @@index([productId])
}

model StockTransfer {
  id           Int      @id @default(autoincrement())
  reference    String   @unique
  fromId       Int
  toId         Int
  status       String   @default("PENDING")  // PENDING, COMPLETED, CANCELLED
  notes        String?  @db.Text
  createdById  Int
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  from      Location        @relation("TransferFrom", fields: [fromId],      references: [id])
  to        Location        @relation("TransferTo",   fields: [toId],        references: [id])
  createdBy User            @relation("TransferCreator", fields: [createdById], references: [id])
  items     StockTransferItem[]

  @@index([fromId])
  @@index([toId])
  @@index([status])
  @@index([createdAt])
}

model StockTransferItem {
  id         Int @id @default(autoincrement())
  transferId Int
  productId  Int
  quantity   Int

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId],  references: [id])

  @@unique([transferId, productId])
  @@index([transferId])
  @@index([productId])
}

// ─── Payment Plans / Installments ────────────────────────────────────────────

model PaymentPlan {
  id               Int      @id @default(autoincrement())
  orderId          Int      @unique
  totalAmount      Float
  paidAmount       Float    @default(0)
  installmentCount Int
  status           String   @default("ACTIVE")  // ACTIVE, COMPLETED, DEFAULTED, CANCELLED
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order         Order                @relation(fields: [orderId], references: [id])
  installments  PaymentInstallment[]

  @@index([status])
  @@index([createdAt])
}

model PaymentInstallment {
  id        Int       @id @default(autoincrement())
  planId    Int
  number    Int
  amount    Float
  dueDate   DateTime
  paidAt    DateTime?
  paidAmount Float    @default(0)
  status    String    @default("PENDING")  // PENDING, PAID, PARTIAL, OVERDUE
  notes     String?

  plan PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([status])
  @@index([dueDate])
}
