generator client {
  provider = "prisma-client-js"
}

// DEV: provider = "sqlite"  |  PRODUCTION: provider = "postgresql"
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth / Users ─────────────────────────────────────────────────────────────

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("employee")
  createdAt DateTime @default(now())

  orders         Order[]
  expenses       Expense[]       @relation("ExpenseCreator")
  incomes        Income[]        @relation("IncomeCreator")
  stockMovements StockMovement[] @relation("StockEmployee")
  auditLogs      AuditLog[]

  @@index([email])
  @@index([role])
}

// ─── Catalogue ────────────────────────────────────────────────────────────────

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  nameAr      String?
  nameKu      String?
  slug        String    @unique
  description String?
  imageUrl    String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  parentId    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([slug])
  @@index([isActive])
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  price         Float
  quantity      Int      @default(0)
  imageUrl      String?
  imagePublicId String?
  categoryId    Int?
  category      String
  sku           String?  @unique
  barcode       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categoryRef    Category?       @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([categoryId])
  @@index([category])
  @@index([quantity])
  @@index([isActive])
  @@index([createdAt])
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id          Int      @id @default(autoincrement())
  userId      Int
  totalAmount Float
  status      String   @default("PENDING")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([createdAt])
  @@index([status])
  @@index([userId])
}

model OrderItem {
  id        Int   @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([orderId])
}

// ─── Finance ──────────────────────────────────────────────────────────────────

model Expense {
  id        Int      @id @default(autoincrement())
  amount    Float
  category  String
  notes     String?
  createdBy Int
  createdAt DateTime @default(now())

  creator User @relation("ExpenseCreator", fields: [createdBy], references: [id])

  @@index([createdAt])
  @@index([createdBy])
  @@index([category])
}

model Income {
  id        Int      @id @default(autoincrement())
  amount    Float
  source    String
  notes     String?
  createdBy Int
  createdAt DateTime @default(now())

  creator User @relation("IncomeCreator", fields: [createdBy], references: [id])

  @@index([createdAt])
  @@index([createdBy])
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  email     String?  @unique
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockMovement {
  id          Int      @id @default(autoincrement())
  productId   Int
  type        String
  quantity    Int
  previousQty Int
  newQty      Int
  notes       String?
  employeeId  Int
  supplierId  Int?
  createdAt   DateTime @default(now())

  product  Product @relation(fields: [productId], references: [id])
  employee User    @relation("StockEmployee", fields: [employeeId], references: [id])

  @@index([productId])
  @@index([employeeId])
  @@index([createdAt])
  @@index([type])
}

// ─── Audit ────────────────────────────────────────────────────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  entity    String
  entityId  Int?
  metadata  String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
}
