generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth / Users ─────────────────────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  role         String   @default("employee")
  fcmToken     String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders            Order[]
  invoices          Invoice[]        @relation("InvoiceCreator")
  expenses          Expense[]        @relation("ExpenseCreator")
  incomes           Income[]         @relation("IncomeCreator")
  stockMovements    StockMovement[]  @relation("StockEmployee")
  auditLogs         AuditLog[]
  notifications     Notification[]
  purchaseOrders    PurchaseOrder[]  @relation("POCreator")
  returnRequests    ReturnRequest[]  @relation("ReturnRequester")
  returnReviews     ReturnRequest[]  @relation("ReturnReviewer")
  couponUsages      CouponUsage[]    @relation("CouponUser")
  stocktakesCreated Stocktake[]      @relation("StocktakeCreator")
  stocktakesReviewed Stocktake[]     @relation("StocktakeReviewer")

  @@index([email])
  @@index([role])
  @@index([isActive])
}

// ─── Catalogue ────────────────────────────────────────────────────────────────

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  nameAr      String?
  nameKu      String?
  slug        String    @unique
  description String?   @db.Text
  imageUrl    String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  parentId    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([slug])
  @@index([isActive])
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?  @db.Text
  price         Float
  costPrice     Float    @default(0)
  quantity      Int      @default(0)
  lowStockAlert Int      @default(5)
  imageUrl      String?
  imagePublicId String?
  categoryId    Int?
  category      String
  sku           String?  @unique
  barcode       String?  @unique
  unit          String    @default("piece")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  categoryRef        Category?          @relation(fields: [categoryId], references: [id])
  orderItems         OrderItem[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  returnItems        ReturnItem[]
  stocktakeItems     StocktakeItem[]

  @@index([categoryId])
  @@index([category])
  @@index([quantity])
  @@index([isActive])
  @@index([createdAt])
  @@index([barcode])
  @@index([deletedAt])
}

// ─── Orders / POS ─────────────────────────────────────────────────────────────

model Order {
  id            Int      @id @default(autoincrement())
  userId        Int
  customerId    Int?
  totalAmount   Float
  discount      Float    @default(0)
  tax           Float    @default(0)
  finalAmount   Float    @default(0)
  status        String   @default("PENDING")
  paymentMethod String   @default("CASH")
  notes         String?  @db.Text
  receiptUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  customer       Customer?       @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  invoice        Invoice?
  returnRequests ReturnRequest[]
  couponUsage    CouponUsage?

  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@index([customerId])
  @@index([paymentMethod])
}

model OrderItem {
  id        Int   @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Float
  discount  Float @default(0)

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id])
  returnItems ReturnItem[]

  @@index([productId])
  @@index([orderId])
}

// ─── Returns & Refunds ────────────────────────────────────────────────────────

model ReturnRequest {
  id          Int      @id @default(autoincrement())
  orderId     Int
  requestedBy Int
  reviewedBy  Int?
  status      String   @default("PENDING")   // PENDING, APPROVED, REJECTED, PROCESSED
  reason      String
  notes       String?  @db.Text
  refundAmount Float   @default(0)
  refundMethod String  @default("ORIGINAL")  // ORIGINAL, STORE_CREDIT, CASH
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order     Order              @relation(fields: [orderId], references: [id])
  requester User               @relation("ReturnRequester", fields: [requestedBy], references: [id])
  reviewer  User?              @relation("ReturnReviewer",  fields: [reviewedBy],  references: [id])
  items     ReturnItem[]

  @@index([orderId])
  @@index([requestedBy])
  @@index([status])
  @@index([createdAt])
}

model ReturnItem {
  id              Int   @id @default(autoincrement())
  returnRequestId Int
  productId       Int
  orderItemId     Int
  quantity        Int
  unitPrice       Float
  condition       String @default("GOOD")   // GOOD, DAMAGED, DEFECTIVE

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])

  @@index([returnRequestId])
  @@index([productId])
}

// ─── Coupons / Discounts ──────────────────────────────────────────────────────

model Coupon {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  description  String?
  type         String   @default("PERCENTAGE")  // PERCENTAGE, FIXED
  value        Float
  minOrderAmount Float  @default(0)
  maxUses      Int?
  usedCount    Int      @default(0)
  isActive     Boolean  @default(true)
  validFrom    DateTime @default(now())
  validUntil   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  usages CouponUsage[]

  @@index([code])
  @@index([isActive])
  @@index([validFrom])
  @@index([validUntil])
}

model CouponUsage {
  id        Int      @id @default(autoincrement())
  couponId  Int
  orderId   Int      @unique
  userId    Int
  discount  Float
  usedAt    DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  order  Order  @relation(fields: [orderId],  references: [id])
  user   User   @relation("CouponUser", fields: [userId], references: [id])

  @@index([couponId])
  @@index([userId])
  @@index([usedAt])
}

// ─── Finance ──────────────────────────────────────────────────────────────────

model Expense {
  id        Int      @id @default(autoincrement())
  amount    Float
  category  String
  notes     String?  @db.Text
  createdBy Int
  createdAt DateTime @default(now())

  creator User @relation("ExpenseCreator", fields: [createdBy], references: [id])

  @@index([createdAt])
  @@index([createdBy])
  @@index([category])
}

model Income {
  id        Int      @id @default(autoincrement())
  amount    Float
  source    String
  notes     String?  @db.Text
  createdBy Int
  createdAt DateTime @default(now())

  creator User @relation("IncomeCreator", fields: [createdBy], references: [id])

  @@index([createdAt])
  @@index([createdBy])
  @@index([source])
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model Supplier {
  id             Int             @id @default(autoincrement())
  name           String
  phone          String?
  email          String?         @unique
  address        String?         @db.Text
  notes          String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@index([deletedAt])
}

model StockMovement {
  id          Int      @id @default(autoincrement())
  productId   Int
  type        String
  quantity    Int
  previousQty Int
  newQty      Int
  notes       String?  @db.Text
  employeeId  Int
  supplierId  Int?
  reference   String?
  createdAt   DateTime @default(now())

  product  Product   @relation(fields: [productId], references: [id])
  employee User      @relation("StockEmployee", fields: [employeeId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([productId])
  @@index([employeeId])
  @@index([createdAt])
  @@index([type])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  body      String   @db.Text
  type      String   @default("info")
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
}

// ─── Audit ────────────────────────────────────────────────────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  entity    String
  entityId  Int?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
}

// ─── Invoices ─────────────────────────────────────────────────────────────────

model Invoice {
  id              Int       @id @default(autoincrement())
  invoiceNumber   String    @unique
  orderId         Int       @unique
  createdById     Int

  status          String    @default("ISSUED")  // DRAFT, ISSUED, PAID, CANCELLED

  // Customer snapshot at invoice time
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  customerAddress String?

  // Financials
  subtotal        Float
  discountType    String    @default("FIXED")   // FIXED, PERCENTAGE
  discountValue   Float     @default(0)
  discountAmount  Float     @default(0)
  taxRate         Float     @default(0)
  taxAmount       Float     @default(0)
  total           Float

  paymentMethod   String    @default("CASH")
  notes           String?   @db.Text

  // PDF storage in Supabase
  pdfUrl          String?
  pdfPublicId     String?

  // QR code data
  qrData          String?

  issuedAt        DateTime  @default(now())
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  order     Order         @relation(fields: [orderId], references: [id])
  createdBy User          @relation("InvoiceCreator", fields: [createdById], references: [id])
  items     InvoiceItem[]

  @@index([invoiceNumber])
  @@index([orderId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  productName String
  productSku  String?
  quantity    Int
  unitPrice   Float
  discount    Float   @default(0)
  total       Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ─── Purchase Orders ──────────────────────────────────────────────────────────

model PurchaseOrder {
  id           Int      @id @default(autoincrement())
  poNumber     String   @unique
  supplierId   Int
  createdById  Int
  status       String   @default("DRAFT")   // DRAFT, SENT, PARTIAL, RECEIVED, CANCELLED
  notes        String?  @db.Text
  expectedDate DateTime?
  receivedAt   DateTime?
  subtotal     Float    @default(0)
  total        Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplier  Supplier           @relation(fields: [supplierId], references: [id])
  createdBy User               @relation("POCreator", fields: [createdById], references: [id])
  items     PurchaseOrderItem[]

  @@index([supplierId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@index([poNumber])
}

model PurchaseOrderItem {
  id               Int    @id @default(autoincrement())
  purchaseOrderId  Int
  productId        Int
  orderedQty       Int
  receivedQty      Int    @default(0)
  unitCost         Float
  total            Float

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

// ─── Customers ────────────────────────────────────────────────────────────────

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String?
  email     String?   @unique
  address   String?   @db.Text
  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  orders        Order[]
  loyaltyAccount LoyaltyAccount?

  @@index([name])
  @@index([phone])
  @@index([email])
  @@index([createdAt])
  @@index([deletedAt])
}

// ─── Customer Loyalty ─────────────────────────────────────────────────────────

model LoyaltyAccount {
  id             Int      @id @default(autoincrement())
  customerId     Int      @unique
  points         Int      @default(0)
  lifetimePoints Int      @default(0)
  tier           String   @default("BRONZE")   // BRONZE, SILVER, GOLD, PLATINUM
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer     Customer             @relation(fields: [customerId], references: [id])
  transactions LoyaltyTransaction[]

  @@index([customerId])
  @@index([tier])
  @@index([points])
}

model LoyaltyTransaction {
  id          Int      @id @default(autoincrement())
  accountId   Int
  type        String                // EARN, REDEEM, ADJUST, EXPIRE
  points      Int
  balance     Int
  orderId     Int?
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([type])
  @@index([createdAt])
  @@index([orderId])
}

// ─── Stocktake / Cycle Count ──────────────────────────────────────────────────

model Stocktake {
  id          Int      @id @default(autoincrement())
  reference   String   @unique
  status      String   @default("DRAFT")   // DRAFT, IN_PROGRESS, COMPLETED, CANCELLED
  notes       String?  @db.Text
  createdById Int
  reviewedById Int?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy  User            @relation("StocktakeCreator",  fields: [createdById],  references: [id])
  reviewedBy User?           @relation("StocktakeReviewer", fields: [reviewedById], references: [id])
  items      StocktakeItem[]

  @@index([status])
  @@index([createdById])
  @@index([createdAt])
}

model StocktakeItem {
  id           Int     @id @default(autoincrement())
  stocktakeId  Int
  productId    Int
  expectedQty  Int
  countedQty   Int?
  variance     Int?
  notes        String?

  stocktake Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([stocktakeId, productId])
  @@index([stocktakeId])
  @@index([productId])
}
