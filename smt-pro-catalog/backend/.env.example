# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Public-facing URL of the backend (used to build absolute image URLs)
# Example: https://api.daraliraq.com
PUBLIC_URL=http://localhost:3000

# CORS: comma-separated allowed origins
# Example: https://daraliraq.com,https://admin.daraliraq.com
ALLOWED_ORIGINS=http://localhost:4000

# ─── Database (PostgreSQL via Supabase) ──────────────────────────────────────
# Pooled connection (used by the app at runtime)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection (used by Prisma migrations / db push)
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ─── Supabase Storage (Image Uploads) ────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_KEY=eyJ...  # Service Role key (not anon key)

# ─── Redis Cache (Optional — falls back to in-memory if not set) ─────────────
# Upstash Redis: https://console.upstash.com
# Format: rediss://:[PASSWORD]@[HOST]:[PORT]
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# ─── Sentry Error Tracking (Optional) ────────────────────────────────────────
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ─── Firebase Push Notifications (Optional) ──────────────────────────────────
# Paste the entire service account JSON as a single-line string
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
